# Copy to rag/.env (gitignored) and fill in. Paths are relative to rag/.

# --- Site: must match docusaurus.config.ts ---
SITE_ROOT=..
CONTENT_DIRS=docs
DOCS_ROUTE_BASE=/docs
SITE_BASE_URL=/
PUBLIC_SITE_URL=http://localhost:3000

# --- Index and embeddings ---
CHROMA_DIR=data/chroma
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBED_CACHE_DIR=data/models

# --- Chunking and retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Midpoint between the top off-topic score (0.335) and the lowest correct hit
# (0.424) on 40 labelled questions. It depends on the model and the docs, so
# measure it again if either changes.
MIN_SCORE=0.38

# --- Generation ---
# none = retrieval-only, ollama = local model, anthropic = Claude API.
LLM_PROVIDER=none

# Ollama: needs the Ollama app running and the model pulled.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Seconds to wait. Raise it for CPU-only machines, where a cold start is slow.
OLLAMA_TIMEOUT=120
# Layers on the GPU. Leave empty for automatic, or use 0 to force CPU only.
OLLAMA_NUM_GPU=

# Anthropic: only used when LLM_PROVIDER=anthropic. Never commit a real key.
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- API ---
ALLOWED_ORIGINS=http://localhost:3000
